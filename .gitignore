# Godot's local import cache; regenerated automatically on open.
.godot/

# Stray temp files from editors and tools.
*.tmp

# Export presets can end up carrying signing paths or keystore locations.
export_presets.cfg

# Generated by tools/capture_screens.gd for a design handoff; regenerate with
# the tool rather than committing binaries. The hand-picked pack under
# selected/ IS committed: it is what the design side reviews, and a review of
# screenshots nobody else can see is not a review. docs/.gdignore keeps Godot
# out of the whole directory, so none of it gets an .import file.
docs/screenshots/*
!docs/screenshots/selected/
docs/screenshots/selected/*
!docs/screenshots/selected/*.png
